# AI Quiz Arena - Environment Variables Configuration
# Copy this file to .env.local for local development

# Base Site URL for SEO, canonical tags, sitemap, and social sharing
NEXT_PUBLIC_SITE_URL=https://aiquizarena.com

# Google AdSense Configuration
# Replace ca-pub-XXXXXXXXXXXXXXX with your approved Publisher ID
NEXT_PUBLIC_ADSENSE_CLIENT_ID=ca-pub-XXXXXXXXXXXXXXX

# AdSlot IDs (obtain these from your Google AdSense Dashboard -> Ads -> By ad unit)
NEXT_PUBLIC_ADSENSE_SLOT_HOME=1234567890
NEXT_PUBLIC_ADSENSE_SLOT_QUIZ=2345678901
NEXT_PUBLIC_ADSENSE_SLOT_RESULT=3456789012
NEXT_PUBLIC_ADSENSE_SLOT_SIDEBAR=4567890123

# Google Analytics 4 Measurement ID (optional)
NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX
